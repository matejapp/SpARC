{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "sparc-api",
    "Audience": "sparc-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RefreshFamilyDays": 90
  },
  "FxRates": {
    "BaseUrl": "https://kurs.resenje.org/",
    "TimeoutSeconds": 5,
    "BackfillDelayMilliseconds": 250
  },
  "FiscalReceipts": {
    "BaseUrl": "https://suf.purs.gov.rs/",
    "TimeoutSeconds": 5
  },
  "ReceiptOcr": {
    "BaseUrl": "http://127.0.0.1:8100/",
    "TimeoutSeconds": 25
  }
}
